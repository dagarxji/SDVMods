{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Transfer Changes from Worktree",
            "detail": "Apply another git worktree's changes onto the current branch, without merging",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/Transfer-WorktreeChanges.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
